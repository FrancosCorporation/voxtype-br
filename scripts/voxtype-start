#!/bin/bash
# voxtype-start — Inicia o daemon do Voxtype com GPU (Vulkan).
# Uso: ./voxtype-start
set -e

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype"
VOXTYPE_BIN="/usr/bin/voxtype"
VULKAN_CANDIDATES=(
    "/usr/lib/voxtype/voxtype-vulkan"
    "/usr/local/lib/voxtype/voxtype-vulkan"
    "$HOME/.local/lib/voxtype/voxtype-vulkan"
)

info()  { echo "ℹ️  $*"; }
ok()    { echo "✅ $*"; }
warn()  { echo "⚠️  $*"; }

# Garante que o OSD está no PATH
if [ -x "$HOME/.local/bin/voxtype-osd" ] && ! command -v voxtype-osd >/dev/null 2>&1; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Verifica o daemon do ydotool (necessário para injeção no Wayland)
if ! pgrep -x ydotoold >/dev/null 2>&1; then
    warn "ydotoold não está rodando. Inicie-o primeiro (sudo ydotoold &)" >&2
    exit 1
fi

# Para o daemon do voxtype caso esteja rodando como systemd user service
if systemctl --user is-active voxtype.service >/dev/null 2>&1; then
    info "Parando serviço systemd voxtype.service..."
    systemctl --user stop voxtype.service || true
fi

stop_daemon() {
    # 1) Mata pelo PID file (voxtype.lock) — caminho canônico do daemon
    if [ -f "$RUNTIME_DIR/voxtype.lock" ]; then
        local pid
        pid=$(cat "$RUNTIME_DIR/voxtype.lock" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            info "Parando daemon atual (PID $pid)..."
            kill "$pid" 2>/dev/null || true
            for _ in $(seq 1 25); do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.2
            done
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$RUNTIME_DIR/voxtype.lock"
    fi
    # 2) Fallback: padrões de linha de comando dos binários tiered
    pkill -f "voxtype-vulkan daemon" 2>/dev/null || true
    pkill -f "voxtype-avx.* daemon" 2>/dev/null || true
    pkill -f "voxtype-native daemon" 2>/dev/null || true
    pkill -f "voxtype daemon" 2>/dev/null || true
    sleep 1
    # 3) Mata OSDs duplicados (o daemon novo respawna o OSD automaticamente)
    pkill -f "voxtype-osd" 2>/dev/null || true
}

stop_daemon

# ----- Detecta o binário Vulkan (GPU) -----
VULKAN_BIN=""
for p in "${VULKAN_CANDIDATES[@]}"; do
    if [ -x "$p" ]; then
        VULKAN_BIN="$p"
        break
    fi
done

ACTIVE_BIN=""
if [ -e "$VOXTYPE_BIN" ]; then
    ACTIVE_BIN=$(readlink -f "$VOXTYPE_BIN")
fi

echo "🔍 Backend ativo atual: ${ACTIVE_BIN:-voxtype (desconhecido)}"

DAEMON_BIN="voxtype"
if [ -n "$VULKAN_BIN" ]; then
    ok "Binário Vulkan encontrado: $VULKAN_BIN"
    DAEMON_BIN="$VULKAN_BIN"
else
    # O wrapper /usr/bin/voxtype suporta VOXTYPE_GPU=1 (executa voxtype-vulkan).
    # Usado como fallback quando o .deb não expõe o binário em /usr/lib/voxtype.
    warn "Binário Vulkan NÃO encontrado em /usr/lib/voxtype/."
    warn "Tentando via wrapper com VOXTYPE_GPU=1 (funciona no .deb 0.7.1+)."
    export VOXTYPE_GPU=1
fi

# ----- Inicia o daemon -----
# IMPORTANTE: em instalações .deb, /usr/bin/voxtype é um symlink para o binário
# CPU/GPU escolhido pelo `voxtype setup gpu`. A variável VOXTYPE_GPU=1 SÓ funciona
# no wrapper do AppImage — por isso aqui executamos o binário Vulkan diretamente.
echo "🚀 Iniciando Voxtype com GPU (Vulkan)..."
setsid nohup env "$DAEMON_BIN" daemon > /tmp/voxtype.log 2>&1 < /dev/null &
disown

sleep 5

# ----- Verificação -----
NEW_PID=""
if [ -f "$RUNTIME_DIR/voxtype.lock" ]; then
    NEW_PID=$(cat "$RUNTIME_DIR/voxtype.lock" 2>/dev/null || true)
fi

if [ -n "$NEW_PID" ] && kill -0 "$NEW_PID" 2>/dev/null; then
    ok "Voxtype rodando (PID $NEW_PID)"
else
    warn "Daemon não confirmado pelo lockfile. Veja /tmp/voxtype.log"
fi

if [ -n "$VULKAN_BIN" ]; then
    if grep -q "ggml_vulkan\|use gpu = 1\|Found .* Vulkan devices" /tmp/voxtype.log 2>/dev/null; then
        ok "GPU (Vulkan) em uso! Transcrição rápida."
    else
        warn "Daemon iniciado, mas a GPU ainda não confirmada no log."
        info "O modelo carrega na 1ª gravação — confira após o 1º ditado:"
        info "    grep -i vulkan /tmp/voxtype.log"
    fi
fi

echo ""
echo "   Atalho: Ctrl+Shift+Espaço (1ª = grava, 2ª = cola no cursor)"
echo "   Log:    tail -f /tmp/voxtype.log"
echo "   Estado: voxtype status"