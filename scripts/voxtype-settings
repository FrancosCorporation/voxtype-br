#!/usr/bin/env python3
"""Voxtype Configurações — diálogo para escolher como inserir a transcrição.

Acessível pelo menu do GNOME ("Voxtype") ou direto: voxtype-settings

Opções:
  - Colar instantâneo (Ctrl+Shift+V) — recomendado: atômico, não "come" letras
  - Digitar visivelmente — tecla por tecla, para quem quer ver a digitação

Salva a escolha em ~/.config/voxtype/output_mode (lido pelo voxtype-type).
"""
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

CONFIG_DIR = os.path.expanduser("~/.config/voxtype")
MODE_FILE = os.path.join(CONFIG_DIR, "output_mode")


def read_mode():
    try:
        with open(MODE_FILE) as f:
            m = f.read().strip()
        if m in ("paste", "type"):
            return m
    except OSError:
        pass
    return "paste"


def write_mode(mode):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(MODE_FILE, "w") as f:
        f.write(mode + "\n")


class SettingsDialog:
    def __init__(self):
        self.mode = read_mode()

        self.window = Gtk.Window(title="Voxtype — Modo de saída")
        self.window.set_default_size(420, 200)
        self.window.set_resizable(False)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_border_width(16)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.window.add(box)

        title = Gtk.Label(label="Como inserir a transcrição no texto?")
        title.set_halign(Gtk.Align.START)
        title.get_style_context().add_class("title")
        box.pack_start(title, False, False, 0)

        self.radio_paste = Gtk.RadioButton(
            label="⚡ Colar instantâneo (Ctrl+Shift+V)")
        self.radio_paste.set_halign(Gtk.Align.START)
        self.radio_paste.set_tooltip_text(
            "Copia para o clipboard e cola tudo de uma vez. "
            "Instantâneo e sem perder letras. Funciona em terminais e apps.")
        box.pack_start(self.radio_paste, False, False, 0)

        self.radio_type = Gtk.RadioButton(
            group=self.radio_paste,
            label="⌨️ Digitar visivelmente (tecla por tecla)")
        self.radio_type.set_halign(Gtk.Align.START)
        self.radio_type.set_tooltip_text(
            "Digita o texto como se fosse um teclado — você vê a digitação. "
            "Mais lento em textos longos.")
        box.pack_start(self.radio_type, False, False, 0)

        if self.mode == "paste":
            self.radio_paste.set_active(True)
        else:
            self.radio_type.set_active(True)

        btn_box = Gtk.Box(spacing=8)
        btn_box.set_halign(Gtk.Align.END)
        box.pack_end(btn_box, False, False, 0)

        btn_cancel = Gtk.Button(label="Cancelar")
        btn_cancel.connect("clicked", lambda _: self.window.destroy())
        btn_box.pack_start(btn_cancel, False, False, 0)

        btn_ok = Gtk.Button(label="OK")
        btn_ok.get_style_context().add_class("suggested-action")
        btn_ok.connect("clicked", self.on_ok)
        btn_box.pack_start(btn_ok, False, False, 0)

        self.window.connect("destroy", Gtk.main_quit)
        self.window.show_all()

    def on_ok(self, _):
        mode = "paste" if self.radio_paste.get_active() else "type"
        write_mode(mode)
        self.window.destroy()


def main():
    try:
        SettingsDialog()
    except Exception as e:
        print(f"voxtype-settings: {e}", file=sys.stderr)
        sys.exit(1)
    Gtk.main()


if __name__ == "__main__":
    main()