#!/usr/bin/env python3
"""Voxtype OSD — overlay na tela com speaker + onda senoidal animada.

Mostra o estado do ditado SEM roubar o foco (o texto cola na caixa de
diálogo onde o cursor estava):

  - recording     : speaker + onda VERMELHA que cresce conforme o volume da voz
  - transcribing  : onda AZUL pulsante + "Transcrevendo..."
  - idle          : janela oculta

Segurança de foco (crítica para a colagem no cursor):
  - set_accept_focus(False) — a janela nunca recebe foco de teclado
  - hint NOTIFICATION + skip-taskbar + keep-above — OSD sem decoração
  - sem present()/grab_focus() — apenas move() + show()
  - click-through — input region vazia (cliques atravessam)
  - ancorado na parte inferior central do monitor — não cobre a caixa de texto

Variáveis de ambiente (para demo/screenshots):
  VOXTYPE_STATE_FILE, VOXTYPE_AUDIO_SOCK, VOXTYPE_OSD_SIZE
"""
import math
import os
import socket
import struct
import sys
import threading
import time

import cairo  # DEVE vir antes do gi/Gtk: registra o conversor do cairo.Context
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
STATE_FILE = os.environ.get("VOXTYPE_STATE_FILE", os.path.join(RUNTIME_DIR, "voxtype", "state"))
AUDIO_SOCK = os.environ.get("VOXTYPE_AUDIO_SOCK", os.path.join(RUNTIME_DIR, "voxtype", "audio.sock"))

OSD_W, OSD_H = 380, 118
FRAME_BYTES = 16
DBFS_FLOOR = 60.0
SMOOTHING = 0.32
FRAME_MS = 33

ACCENT = {
    "recording": (0.96, 0.31, 0.31, 1.0),
    "streaming": (0.96, 0.31, 0.31, 1.0),
    "transcribing": (0.30, 0.68, 0.95, 1.0),
}


def rounded_rect(cr, x, y, w, h, r):
    r = min(r, w / 2.0, h / 2.0)
    cr.move_to(x + r, y)
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_osd(cr, width, height, state, level, phase, tick):
    """Desenha o overlay completo. Função pura — usada pelo OSD e pelos
    screenshots do README (docs/generate_screenshots.py)."""
    accent = ACCENT.get(state, (0.45, 0.45, 0.50, 0.6))
    recording = state in ("recording", "streaming")
    transcribing = state == "transcribing"

    # Fundo transparente
    cr.save()
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()

    w, h = width, height
    pad = 8
    radius = min(22.0, h / 2.0 - pad)

    # Pílula de fundo
    cr.translate(pad, pad)
    cr.set_source_rgba(0.04, 0.05, 0.09, 0.88)
    rounded_rect(cr, 0, 0, w - 2 * pad, h - 2 * pad, radius)
    cr.fill()

    # Borda (pulsante quando transcrevendo)
    pulse = 0.55 + 0.45 * math.sin(tick * 0.09)
    border_alpha = pulse if transcribing else 0.5
    cr.set_source_rgba(accent[0], accent[1], accent[2], border_alpha)
    cr.set_line_width(2)
    rounded_rect(cr, 1, 1, w - 2 * pad - 2, h - 2 * pad - 2, radius - 1)
    cr.stroke()

    # --- Speaker (esquerda, pulsa com o volume) ---
    lvl = max(0.0, min(1.0, level))
    sp_x, sp_y = 46.0, 55.0
    bounce = 1.0 + 0.06 * lvl * math.sin(phase * 2.0)
    body_w, body_h = 22.0 * bounce, 30.0 * bounce
    cr.set_source_rgba(0.92, 0.94, 0.97, 0.95)
    rounded_rect(cr, sp_x - body_w / 2, sp_y - body_h / 2, body_w, body_h, 3.5)
    cr.fill()
    cone_x = sp_x + body_w / 2
    cr.move_to(cone_x, sp_y - body_h / 2)
    cr.line_to(cone_x + 15 * bounce, sp_y - body_h / 2 - 9 * bounce)
    cr.line_to(cone_x + 15 * bounce, sp_y + body_h / 2 + 9 * bounce)
    cr.line_to(cone_x, sp_y + body_h / 2)
    cr.close_path()
    cr.fill()

    # --- Ondas sonoras (crescem com o volume da voz) ---
    wave_origin_x = cone_x + 15 * bounce
    for i, base in enumerate((18.0, 30.0)):
        r = base + lvl * 12.0
        alpha = min(0.95, (0.25 + 0.25 * i) + 0.55 * lvl)
        cr.set_source_rgba(accent[0], accent[1], accent[2], alpha)
        cr.set_line_width(3.4 - i * 0.9)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.arc(wave_origin_x, sp_y, r, -0.62, 0.62)
        cr.stroke()

    # --- Onda senoidal clássica (faixa contínua, cresce com a voz) ---
    wave_y = 84.0
    if recording:
        wave_amp = 5.0 + lvl * 17.0
    elif transcribing:
        wave_amp = 9.0 + 4.0 * math.sin(tick * 0.1)
    else:
        wave_amp = 4.0
    wave_x0 = 90.0
    wave_x1 = w - 2 * pad - 24
    steps = 72
    # brilho suave atrás da onda
    cr.set_source_rgba(accent[0], accent[1], accent[2], 0.22)
    cr.set_line_width(5.0)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(wave_x0, wave_y)
    for i in range(steps + 1):
        t = i / steps
        x = wave_x0 + t * (wave_x1 - wave_x0)
        env = math.sin(math.pi * t)
        y = wave_y + math.sin(t * 9.0 + phase) * wave_amp * env
        cr.line_to(x, y)
    cr.stroke()
    # traço principal da onda
    cr.set_source_rgba(accent[0], accent[1], accent[2], 0.95)
    cr.set_line_width(4.5)
    cr.move_to(wave_x0, wave_y)
    for i in range(steps + 1):
        t = i / steps
        x = wave_x0 + t * (wave_x1 - wave_x0)
        env = math.sin(math.pi * t)
        y = wave_y + math.sin(t * 9.0 + phase) * wave_amp * env
        cr.line_to(x, y)
    cr.stroke()

    # --- Rótulo (canto superior esquerdo, longe das ondas) ---
    if recording:
        label = "Ouvindo..."
    elif transcribing:
        label = "Transcrevendo..."
    else:
        label = "Voxtype"
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(13)
    cr.set_source_rgba(0.93, 0.94, 0.97, 0.95)
    cr.move_to(16.0, 27.0)
    cr.show_text(label)

    cr.restore()


class VoxtypeOSD:
    """Janela overlay transparente, sempre-por-cima, click-through e sem foco."""

    def __init__(self):
        self.state = "idle"
        self.level = 0.0
        self.raw_level = 0.0
        self.phase = 0.0
        self.tick = 0

        self.window = Gtk.Window(type=Gtk.WindowType.POPUP)
        self.window.set_app_paintable(True)
        self.window.set_decorated(False)
        self.window.set_accept_focus(False)
        self.window.set_skip_taskbar_hint(True)
        self.window.set_skip_pager_hint(True)
        self.window.set_keep_above(True)
        self.window.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.window.set_default_size(OSD_W, OSD_H)
        self.window.set_resizable(False)

        screen = self.window.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.window.set_visual(visual)

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(OSD_W, OSD_H)
        self.area.connect("draw", self.on_draw)
        self.window.add(self.area)

        self.position_window()
        self.window.show_all()
        try:
            gdk_win = self.window.get_window()
            if gdk_win is not None:
                gdk_win.input_shape_combine_region(Gdk.Region(), 0, 0)
        except Exception:
            pass
        self.window.hide()

        threading.Thread(target=self.watch_state, daemon=True).start()
        threading.Thread(target=self.watch_audio, daemon=True).start()
        GLib.timeout_add(FRAME_MS, self.on_tick)

    def position_window(self):
        try:
            display = Gdk.Display.get_default()
            monitor = display.get_primary_monitor() if display else None
            if monitor is None and display is not None and display.get_n_monitors() > 0:
                monitor = display.get_monitor(0)
            if monitor is not None:
                geo = monitor.get_geometry()
                x = geo.x + (geo.width - OSD_W) // 2
                y = geo.y + geo.height - OSD_H - 64
                self.window.move(x, y)
                return
        except Exception:
            pass
        # Fallback: deixa o compositor centralizar
        self.window.set_position(Gtk.WindowPosition.CENTER)

    def on_draw(self, widget, cr):
        draw_osd(cr, OSD_W, OSD_H, self.state, self.level, self.phase, self.tick)
        return False

    def set_state(self, state):
        self.state = state
        visible = state in ("recording", "streaming", "transcribing")
        if visible and not self.window.get_visible():
            self.window.show_all()
        elif not visible and self.window.get_visible():
            self.window.hide()
        self.area.queue_draw()
        return False

    def watch_state(self):
        last = None
        while True:
            try:
                with open(STATE_FILE) as f:
                    state = f.read().strip()
            except OSError:
                state = ""
            if state != last:
                last = state
                GLib.idle_add(self.set_state, state)
            time.sleep(0.15)

    def watch_audio(self):
        while True:
            try:
                if not os.path.exists(AUDIO_SOCK):
                    time.sleep(1)
                    continue
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(5)
                s.connect(AUDIO_SOCK)
                buf = b""
                while True:
                    try:
                        data = s.recv(FRAME_BYTES)
                        if not data:
                            break
                        buf += data
                        while len(buf) >= FRAME_BYTES:
                            frame = buf[:FRAME_BYTES]
                            buf = buf[FRAME_BYTES:]
                            _seq, _lo, _hi, peak_dbfs = struct.unpack("<Ifff", frame)
                            GLib.idle_add(self.on_audio_level, peak_dbfs)
                    except socket.timeout:
                        continue
                    except OSError:
                        break
            except OSError:
                time.sleep(1)

    def on_audio_level(self, val):
        try:
            dbfs = float(val)
        except (TypeError, ValueError):
            dbfs = -120.0
        if not math.isfinite(dbfs):
            dbfs = -120.0
        lvl = max(0.0, min(1.0, (dbfs + DBFS_FLOOR) / DBFS_FLOOR))
        self.raw_level = lvl
        return False

    def on_tick(self):
        self.tick += 1
        self.phase += 0.14
        if self.state in ("recording", "streaming"):
            self.level += (self.raw_level - self.level) * SMOOTHING
        elif self.state == "transcribing":
            self.level = 0.5 + 0.2 * math.sin(self.tick * 0.12)
        else:
            self.level *= 0.9
        self.area.queue_draw()
        return True


def main():
    try:
        VoxtypeOSD()
    except Exception as e:
        print(f"voxtype-osd: {e}", file=sys.stderr)
        sys.exit(1)
    Gtk.main()


if __name__ == "__main__":
    main()