#!/usr/bin/env python3
"""Voxtype OSD — overlay visual com onda senoidal animada conforme o nível de voz.

Monitora o state file do voxtype (/run/user/<uid>/voxtype/state) e o socket
de nível de áudio (/run/user/<uid>/voxtype/audio.sock) para exibir:
  - Onda senoidal animada que cresce/ondula conforme o volume da voz
  - "Ouvindo..." (vermelho) durante gravação
  - "Transcrevendo..." (azul) durante transcrição
  - Sem overlay quando idle

Importante: a janela NÃO rouba o foco (set_accept_focus=False + sem present),
para que a injeção caia no aplicativo correto (terminal, editor, etc.).
Ela também fica no TOPO da tela (nunca cobre a caixa de diálogo) e é
click-through (cliques atravessam para a janela de baixo), então a seleção
do campo onde você estava não se perde.
"""
import math
import os
import socket
import struct
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk, Pango
import cairo

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
STATE_FILE = os.path.join(RUNTIME_DIR, "voxtype", "state")
AUDIO_SOCK = os.path.join(RUNTIME_DIR, "voxtype", "audio.sock")

# Cores (R, G, B, A)
COLORS = {
    "recording": (0.95, 0.30, 0.30, 1.0),     # vermelho
    "transcribing": (0.30, 0.70, 0.95, 1.0),   # azul
    "idle": (0.45, 0.45, 0.50, 0.6),
}

WIDTH = 340
HEIGHT = 120
AMP_MAX = 34.0        # amplitude máxima da onda (px)
FREQ = 2.2            # frequência da onda
SMOOTHING = 0.35      # suavização do nível (0..1)
AUDIO_PEAK_DECAY = 0.15

# Protocolo do socket de áudio do Voxtype (src/audio/levels.rs):
# o daemon emite AudioFrame de 16 bytes a ~100 Hz:
#   seq: u32  (contador, native byte order)
#   min: f32  (menor amostra, -1.0..1.0)
#   max: f32  (maior amostra, -1.0..1.0)
#   peak_dbfs: f32 (pico em dBFS, -120.0 (silêncio) .. ~0.0 (alto))
FRAME_BYTES = 16
DBFS_FLOOR = 60.0     # dB abaixo do pico considerado "silêncio" para a onda


class VoxtypeOSD(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_app_paintable(True)
        self.set_accept_focus(False)      # não rouba o foco
        self.set_can_focus(False)
        self.set_resizable(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)  # janela OSD (GNOME)
        self.set_keep_above(True)
        # Sem posição fixa: present_quiet() ancora no topo via self.move().
        self.set_default_size(WIDTH, HEIGHT)
        # Click-through: cliques atravessam o OSD para a janela de baixo,
        # preservando a seleção da caixa de diálogo (via input shape vazia
        # aplicada no realize e a cada exibição).
        self.connect("realize", lambda w: self.make_click_through())

        self.state = "idle"
        self.level = 0.0          # nível atual suavizado
        self.raw_level = 0.0
        self.phase = 0.0          # fase da onda (para animação contínua)
        self.time = 0.0

        # Container principal com padding
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.set_margin_top(18)
        self.box.set_margin_bottom(12)
        self.box.set_margin_start(18)
        self.box.set_margin_end(18)
        self.add(self.box)

        # Rótulo de estado (com ícone de microfone inline)
        self.state_label = Gtk.Label(label="🎙  Ouvindo...")
        self.state_label.set_halign(Gtk.Align.CENTER)
        self.state_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.state_label.set_max_width_chars(30)
        self.box.pack_start(self.state_label, False, False, 0)

        # Área de desenho da onda senoidal
        self.wave_area = Gtk.DrawingArea()
        self.wave_area.set_size_request(WIDTH - 36, 56)
        self.wave_area.connect("draw", self.on_draw)
        self.box.pack_start(self.wave_area, False, False, 0)

        # Estilo: fundo escuro arredondado
        css = b"""
        window {
            background-color: rgba(12, 14, 22, 0.92);
            border-radius: 14px;
        }
        label {
            font-family: 'Inter', 'Cantarell', sans-serif;
            font-size: 13px;
            color: #e2e2e8;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.show_all()
        self.hide()

        # Threads de monitoramento
        threading.Thread(target=self.watch_state, daemon=True).start()
        threading.Thread(target=self.watch_audio, daemon=True).start()

        GLib.timeout_add(33, self.on_tick)  # ~30 fps

    # ---------- Estado ----------
    def watch_state(self):
        last = None
        while True:
            try:
                with open(STATE_FILE) as f:
                    state = f.read().strip()
                if state != last:
                    last = state
                    GLib.idle_add(self.on_state_change, state)
            except Exception:
                pass
            time.sleep(0.2)

    def on_state_change(self, state):
        self.state = state
        if state in ("recording", "streaming"):
            self.state_label.set_text("🎙  Ouvindo...")
            self.state_label.set_color(Gdk.RGBA(*COLORS["recording"]))
            self.present_quiet()
        elif state == "transcribing":
            self.state_label.set_text("⏳  Transcrevendo...")
            self.state_label.set_color(Gdk.RGBA(*COLORS["transcribing"]))
            self.present_quiet()
        elif state in ("idle", "stopped"):
            self.hide()
        return False

    def make_click_through(self):
        """Torna o OSD transparente a cliques (input shape vazia).

        Sem isso, o OSD — mesmo sem foco de teclado — intercepta cliques do
        mouse e a caixa de diálogo perde a seleção ao clicar "nele".
        Best-effort: se o compositor ignorar, o resto (topo + sem foco)
        já evita o problema na prática.
        """
        try:
            win = self.get_window()
            if win is None:
                return
            win.input_shape_combine_region(cairo.Region(), 0, 0)
        except Exception:
            pass

    def present_quiet(self):
        """Mostra a janela SEM roubar o foco do aplicativo ativo.

        Janelas NOTIFICATION (tipo OSD) não recebem foco no GNOME Wayland.
        show_all + keep_above garante visibilidade sem focar.
        Ancorada no TOPO centralizado: nunca cobre a caixa de diálogo onde
        o cursor está (o motivo nº 1 da "seleção sumindo" ao dar o atalho).
        """
        self.show_all()
        self.set_keep_above(True)
        self.stick()
        try:
            screen = Gdk.Screen.get_default()
            if screen is not None:
                monitor = screen.get_primary_monitor()
                geo = screen.get_monitor_geometry(monitor)
                x = geo.x + (geo.width - WIDTH) // 2
                y = geo.y + 36  # abaixo da top bar do GNOME
                self.move(x, y)
        except Exception:
            pass
        # Reaplica o click-through após cada show (alguns compositores
        # resetam a input shape quando a janela é remapeada).
        try:
            GLib.idle_add(self.make_click_through)
        except Exception:
            pass

    # ---------- Nível de áudio ----------
    def watch_audio(self):
        while True:
            try:
                if not os.path.exists(AUDIO_SOCK):
                    time.sleep(1)
                    continue
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(5)
                s.connect(AUDIO_SOCK)
                buf = b""
                while True:
                    try:
                        data = s.recv(FRAME_BYTES)
                        if not data:
                            break
                        buf += data
                        # Consome frames completos de 16 bytes (AudioFrame)
                        while len(buf) >= FRAME_BYTES:
                            frame = buf[:FRAME_BYTES]
                            buf = buf[FRAME_BYTES:]
                            seq, lo, hi, peak_dbfs = struct.unpack("<Ifff", frame)
                            GLib.idle_add(self.on_audio_level, peak_dbfs)
                    except socket.timeout:
                        continue
                    except Exception:
                        break
            except Exception:
                time.sleep(1)

    def on_audio_level(self, val):
        try:
            dbfs = float(val)
        except Exception:
            dbfs = -120.0
        # peak_dbfs: -inf/-120 (silêncio) .. ~0 (alto) → 0..1
        if not math.isfinite(dbfs):
            dbfs = -120.0
        lvl = (dbfs + DBFS_FLOOR) / DBFS_FLOOR
        lvl = max(0.0, min(1.0, lvl))
        self.raw_level = lvl
        # suavização
        self.level = self.level + SMOOTHING * (lvl - self.level)
        return False

    # ---------- Animação ----------
    def on_tick(self):
        self.time += 1
        self.phase += 0.12
        if self.state in ("recording", "streaming"):
            # mantém a onda viva mesmo com nível 0 (respiração)
            self.level += (self.raw_level - self.level) * SMOOTHING
        elif self.state == "transcribing":
            # onda com "loading" suave durante transcrição
            self.level = 0.25 + 0.15 * math.sin(self.time * 0.15)
        else:
            self.level *= (1 - AUDIO_PEAK_DECAY)
        self.wave_area.queue_draw()
        return True

    # ---------- Desenho da onda senoidal ----------
    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        cy = h / 2.0

        color = COLORS.get(self.state, COLORS["idle"])

        # Nível efetivo (com mínimo visual durante gravação)
        amp = self.level * AMP_MAX
        if self.state in ("recording", "streaming"):
            amp = max(amp, 4.0)

        # Linha de base (center)
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.set_line_width(1)
        cr.move_to(0, cy)
        cr.line_to(w, cy)
        cr.stroke()

        # Onda senoidal
        cr.set_source_rgba(*color)
        cr.set_line_width(2.5)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)

        steps = int(w / 2)
        cr.move_to(0, cy)
        for i in range(steps + 1):
            x = i * 2.0
            t = x / w
            # envelope: mais alto no centro
            env = math.sin(math.pi * t)
            y = cy + math.sin(x * FREQ * 0.08 + self.phase) * amp * env
            cr.line_to(x, y)

        # Sombra suave da onda (reflexo)
        cr.stroke_preserve()
        cr.set_source_rgba(*color[:-1], color[3] * 0.25)
        cr.set_line_width(6)
        cr.stroke()

        # Borda pulsante durante gravação
        if self.state in ("recording", "streaming"):
            pulse = 0.35 + 0.3 * abs(math.sin(self.time * 0.2))
            cr.set_source_rgba(0.95, 0.30, 0.30, pulse)
            cr.set_line_width(3)
            cr.rectangle(4, 4, w - 8, h - 8)
            cr.stroke()

        return True


def main():
    win = VoxtypeOSD()
    Gtk.main()


if __name__ == "__main__":
    main()